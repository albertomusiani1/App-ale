# Copia questo file in ".env" e riempi i valori.
# I valori veri NON vanno mai messi su GitHub: .env è già ignorato da git.

# Supabase → Project Settings → Data API → Project URL
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase → Project Settings → API Keys → anon / public
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# L'email dell'unico account che usate in due (Authentication → Users).
# La password di quell'account è la "password di coppia" che si digita all'avvio.
VITE_COUPLE_EMAIL=noidue@example.com
